"""
Heart Eyes  -  a procedural eye rendered as colored ASCII, with an original synthesized
cinematic soundtrack, built with numpy + pygame.

Timeline (loops every ~15 s):
  0 - 5 s   a brown eye looks around, blinks, pupil breathes
  5 - 8 s   the eye dissolves into the dark, the pupil morphs into a heart
  8 - 13 s  glowing pink heart pulses, sparkles twinkle in the dark
  13 - 15 s heart fades out, eye fades back in

Install:   pip install numpy pygame
Run:       python heart_eyes.py
Keys:      ESC = quit,  SPACE = restart (picture + music),  M = mute,  S = screenshot
"""

import sys
import numpy as np
import pygame

# ----------------------------------------------------------------- settings
COLS, ROWS = 110, 62          # ASCII grid size
CELL_W, CELL_H = 9, 14        # pixel size of one character cell
FONT_SIZE = 14
FPS = 24
LOOP = 15.0

# ---- δικό σου τραγούδι (βάλε το αρχείο στον ίδιο φάκελο με το script)
MUSIC_FILE = "song.mp3"     # .mp3 / .ogg / .wav
MUSIC_START = 23.0          # από ποιο δευτερόλεπτο του τραγουδιού να ξεκινά
MUSIC_FADE_MS = 600         # fade in / fade out στα όρια κάθε κύκλου
RAMP = " .'`^\",:;Il!i~+_-?][}{1)(|/tfjrxnuvczXYUJCLQ0OZmwqpdbkhao*#MW&8%B@$"
RAMP = np.array(list(RAMP))
rng = np.random.default_rng(7)


# ----------------------------------------------------------------- helpers
def smoothstep(a, b, x):
    t = np.clip((x - a) / (b - a + 1e-9), 0, 1)
    return t * t * (3 - 2 * t)


def mix(a, b, t):
    return a + (b - a) * t


# coordinate grid in "square" units (cells are ~1:1.55 tall, so correct for it)
ys, xs = np.mgrid[0:ROWS, 0:COLS].astype(np.float32)
ASPECT = (CELL_W * COLS) / (CELL_H * ROWS)
X = (xs / (COLS - 1) * 2 - 1) * ASPECT      # -aspect .. aspect
Y = ys / (ROWS - 1) * 2 - 1                  # -1 .. 1


# ----------------------------------------------------------------- eye model
def eye_layers(t, look_x, look_y, openness, pupil_r):
    """Return rgb image (ROWS, COLS, 3) in 0..1 for the human eye."""
    # almond shaped eyelid opening
    u = X / 1.15
    lid_h = 0.80 * openness * np.clip(1 - u * u, 0, 1) ** 0.85
    inside = np.abs(Y) < lid_h

    # sclera: slightly pink/white, darker toward the corners
    sclera = np.stack([0.62, 0.52, 0.48], -1) * (1 - 0.55 * np.clip(np.abs(u), 0, 1) ** 2)[..., None]
    sclera = sclera * (1 - 0.45 * (np.abs(Y) / (lid_h + 1e-3)) ** 2)[..., None]

    # iris
    cx, cy = look_x * 0.45, look_y * 0.18
    dx, dy = X - cx, Y - cy
    r = np.sqrt(dx * dx + dy * dy)
    ang = np.arctan2(dy, dx)
    iris_r = 0.50
    in_iris = r < iris_r

    fibers = 0.5 + 0.5 * np.sin(ang * 38 + np.sin(ang * 7) * 2.0)
    fibers2 = 0.5 + 0.5 * np.sin(ang * 90 + r * 20)
    rn = np.clip(r / iris_r, 0, 1)

    inner = np.array([0.95, 0.55, 0.20], np.float32)    # warm amber near pupil
    outer = np.array([0.45, 0.20, 0.07], np.float32)    # deep brown rim
    iris = mix(inner, outer, smoothstep(0.2, 1.0, rn)[..., None])
    iris = iris * (0.55 + 0.45 * fibers[..., None]) * (0.8 + 0.2 * fibers2[..., None])
    limbal = smoothstep(0.80, 1.0, rn)[..., None]       # dark ring around iris
    iris = iris * (1 - 0.75 * limbal)

    # pupil
    pupil = r < pupil_r
    edge = smoothstep(pupil_r + 0.03, pupil_r - 0.01, r)

    img = np.where(in_iris[..., None], iris, sclera)
    img = img * (1 - edge[..., None] * 0.97)

    # specular highlight
    hx, hy = cx - 0.17, cy - 0.17
    hl = np.exp(-(((X - hx) ** 2 + (Y - hy) ** 2) / 0.006))
    img = img + hl[..., None] * 0.9
    hl2 = np.exp(-(((X - cx - 0.15) ** 2 + (Y - cy + 0.14) ** 2) / 0.002))
    img = img + hl2[..., None] * 0.4

    # eyelid skin outside
    skin = np.array([0.38, 0.22, 0.16], np.float32) * (0.5 + 0.3 * (1 - np.abs(Y)))[..., None]
    # lash line (dark rim)
    rim = np.exp(-(((np.abs(Y) - lid_h) / 0.035) ** 2)) * (np.abs(u) < 1.0)
    out = np.where(inside[..., None], img, skin)
    out = out * (1 - 0.9 * rim[..., None])
    return np.clip(out, 0, 1)


# ----------------------------------------------------------------- heart model
def heart_mask(scale, cx=0.0, cy=0.05):
    """Signed-ish heart field: >0 inside. Classic implicit heart curve."""
    x = (X - cx) / scale * 1.25
    y = -(Y - cy) / scale * 1.25 + 0.15
    f = (x * x + y * y - 1) ** 3 - x * x * y ** 3
    return -f


def heart_layer(t, scale):
    f = heart_mask(scale)
    inside = smoothstep(-0.02, 0.05, f)
    # pink gradient with horizontal "scanline" shimmer
    gy = smoothstep(-0.8, 0.8, Y)[..., None]
    pink = mix(np.array([1.0, 0.55, 0.70], np.float32), np.array([0.80, 0.12, 0.35], np.float32), gy)
    glow = np.exp(-np.clip(-f, 0, None) * 6) * 0.35
    shimmer = 0.85 + 0.15 * np.sin(Y * 90 + t * 6)
    col = pink * (0.75 + 0.45 * inside[..., None]) * shimmer[..., None]
    col = col * np.clip(inside + glow, 0, 1)[..., None]
    return np.clip(col, 0, 1), inside


# ----------------------------------------------------------------- sparkles
N_STARS = 45
star_x = rng.uniform(-ASPECT, ASPECT, N_STARS)
star_y = rng.uniform(-1, 1, N_STARS)
star_phase = rng.uniform(0, 6.28, N_STARS)
star_speed = rng.uniform(1.5, 4.0, N_STARS)
star_size = rng.uniform(0.6, 1.4, N_STARS)


def sparkle_layer(t, strength):
    img = np.zeros((ROWS, COLS, 3), np.float32)
    if strength <= 0.01:
        return img
    for i in range(N_STARS):
        b = 0.5 + 0.5 * np.sin(t * star_speed[i] + star_phase[i])
        b = b ** 3 * strength
        if b < 0.05:
            continue
        dx, dy = X - star_x[i], Y - star_y[i]
        # 4-point star: long thin cross + soft core
        cross = np.exp(-(dx / (0.015 * star_size[i])) ** 2) * np.exp(-(np.abs(dy) / (0.05 * star_size[i])))
        cross += np.exp(-(dy / (0.015 * star_size[i])) ** 2) * np.exp(-(np.abs(dx) / (0.07 * star_size[i])))
        core = np.exp(-(dx * dx + dy * dy) / 0.0009)
        img += (cross + core)[..., None] * b * np.array([1.0, 0.92, 0.95], np.float32)
    return np.clip(img, 0, 1)


# ----------------------------------------------------------------- timeline
def compose(t):
    t = t % LOOP

    # eye animation
    look_x = np.sin(t * 0.9) * 0.8
    look_y = np.sin(t * 0.6 + 1.0) * 0.5
    blink_phase = (t % 4.2)
    blink = 1 - np.exp(-((blink_phase - 3.9) / 0.07) ** 2)
    openness = 0.9 * blink
    morph = smoothstep(5.0, 8.0, t)                 # eye -> heart
    back = smoothstep(13.0, 15.0, t)                # heart -> eye
    m = morph * (1 - back)

    pupil_r = mix(0.16 + 0.03 * np.sin(t * 2.0), 0.32, smoothstep(3.5, 6.5, t))
    eye = eye_layers(t, look_x * (1 - m), look_y * (1 - m), openness, pupil_r)

    # eye fades to black as the heart takes over (iris dissolves into particles)
    dissolve = (rng.random((ROWS, COLS)) < (1 - m * 1.15)).astype(np.float32)
    eye_vis = np.clip(1 - m * 1.1, 0, 1)
    eye = eye * eye_vis * np.where(m > 0.05, dissolve, 1.0)[..., None]

    beat = 1 + 0.06 * np.sin(t * 7.0) ** 2
    heart, hmask = heart_layer(t, 0.42 * beat)
    heart *= (m ** 0.7)

    spark = sparkle_layer(t, strength=smoothstep(5.5, 8.0, t) * (1 - back))

    img = np.clip(eye + heart + spark, 0, 1)
    return img


# ----------------------------------------------------------------- ASCII draw
class AsciiRenderer:
    def __init__(self, font):
        self.font = font
        self.cache = {}

    def glyph(self, ch, rgb):
        key = (ch, rgb)
        s = self.cache.get(key)
        if s is None:
            s = self.font.render(ch, True, rgb)
            if len(self.cache) > 40000:
                self.cache.clear()
            self.cache[key] = s
        return s

    def draw(self, surf, img):
        lum = img @ np.array([0.299, 0.587, 0.114], np.float32)
        lum = np.clip(lum ** 0.75, 0, 1)
        idx = (lum * (len(RAMP) - 1)).astype(int)
        q = (np.clip(img / (lum[..., None] + 1e-3), 0, 4))  # chroma ratio
        # boost color so glyphs stay vivid even when dim
        col = np.clip(img * 1.35 + 0.02, 0, 1)
        col = (col * 15).astype(int) * 17                    # 16 levels per channel
        for r in range(ROWS):
            for c in range(COLS):
                i = idx[r, c]
                if i == 0:
                    continue
                rgb = (int(col[r, c, 0]), int(col[r, c, 1]), int(col[r, c, 2]))
                surf.blit(self.glyph(RAMP[i], rgb), (c * CELL_W, r * CELL_H))



# ----------------------------------------------------------------- music
SR = 44100


def _sstep(a, b, x):
    t = np.clip((x - a) / (b - a), 0, 1)
    return t * t * (3 - 2 * t)


def _snap(f):
    """Snap a frequency to a whole number of cycles per loop -> perfectly seamless loop."""
    return round(f * LOOP) / LOOP


def _reverb(sig, seconds=3.2, seed=1):
    """Circular FFT reverb (the tail wraps around, so the loop stays seamless)."""
    r = np.random.default_rng(seed)
    n = len(sig)
    m = int(seconds * SR)
    tt = np.arange(m) / SR
    ir = r.standard_normal(m) * np.exp(-tt / (seconds / 4.5))
    ir = np.convolve(ir, np.ones(24) / 24, mode="same")          # darker tail
    ir[: int(0.02 * SR)] *= np.linspace(0, 1, int(0.02 * SR))      # soft attack
    ir /= np.sqrt(np.sum(ir ** 2))
    IR = np.fft.rfft(ir, n)
    return np.fft.irfft(np.fft.rfft(sig) * IR, n)


def make_music():
    """Build an original cinematic score that follows the visual timeline. Returns int16 (N, 2)."""
    N = int(LOOP * SR)
    t = np.arange(N) / SR
    r = np.random.default_rng(11)
    TAU = 2 * np.pi

    # slow "tension" curve: 0 during the eye, 1 on the heart
    bright = 0.25 + 0.75 * _sstep(4.5, 8.0, t) * (1 - _sstep(13.0, 15.0, t) * 0.7)

    # ---- sub drone (A1) + gentle swell
    f0 = _snap(55.0)
    drone = np.sin(TAU * f0 * t) + 0.35 * np.sin(TAU * 2 * f0 * t)
    drone *= 0.30 + 0.25 * np.sin(TAU * t / LOOP - 1.0) ** 2 + 0.25 * _sstep(5, 8, t)

    # ---- evolving pads: Am - F - C - G, cross-faded around the loop
    chords = [(110.0, 130.81, 164.81), (87.31, 110.0, 130.81),
              (130.81, 164.81, 196.0), (98.0, 123.47, 146.83)]
    bar = LOOP / len(chords)
    padL = np.zeros(N)
    padR = np.zeros(N)
    for ci, notes in enumerate(chords):
        centre = (ci + 0.5) * bar
        d = ((t - centre + LOOP / 2) % LOOP) - LOOP / 2
        w = np.where(np.abs(d) < bar, np.cos(np.pi * d / (2 * bar)) ** 2, 0.0)
        for nf in notes:
            for det, pan in ((-3 / LOOP, 0.25), (0.0, 0.5), (3 / LOOP, 0.75)):
                f = _snap(nf) + det
                vib = 0.0015 * np.sin(TAU * 4 * t / LOOP * 3)          # slow integer-cycle vibrato
                ph = TAU * f * t + vib * TAU * f * 0.0 + 0.6 * np.sin(TAU * 3 * t / LOOP)
                voice = np.zeros(N)
                for k in range(1, 8):
                    g = np.exp(-(k - 1) / (1.0 + 5.0 * bright))
                    voice += g / k * np.sin(k * ph)
                voice *= w
                padL += voice * (1 - pan)
                padR += voice * pan
    # airy octave-up shimmer that blooms with the heart
    for nf in (329.63, 392.0, 493.88):
        f = _snap(nf)
        sh = np.sin(TAU * f * t + 0.8 * np.sin(TAU * 5 * t / LOOP)) * 0.05 * _sstep(5, 8, t) * (1 - _sstep(13, 15, t))
        padL += sh * 0.8
        padR += sh * 1.0

    # ---- riser (4.5 -> 8 s) and impact at 8 s
    rise = _sstep(4.5, 8.0, t) ** 2.2 * (t < 8.0)
    noise = r.standard_normal(N)
    hp = np.diff(noise, prepend=0.0)                                   # crude high-pass
    riser = hp * rise * 0.10
    sweep = np.sin(TAU * np.cumsum(220 + 880 * _sstep(4.5, 8.0, t) ** 2) / SR) * rise * 0.10
    ti = np.clip(t - 8.0, 0, None)
    boom_env = np.exp(-ti / 0.9) * (t >= 8.0)
    boom = np.sin(TAU * np.cumsum(70 * np.exp(-ti / 0.5) + 28) / SR) * boom_env * 1.1
    boom += r.standard_normal(N) * np.exp(-ti / 0.25) * (t >= 8.0) * 0.12

    # ---- heartbeat, locked to the visual pulse: sin(7t)^2 peaks at t = (pi/2 + n*pi) / 7
    heart = np.zeros(N)
    beat_gain = _sstep(7.0, 8.5, t) * (1 - _sstep(13.0, 14.6, t))
    n = 0
    while True:
        bt = (np.pi / 2 + n * np.pi) / 7.0
        n += 1
        if bt > LOOP:
            break
        if bt < 6.0:
            continue
        for off, amp in ((0.0, 1.0), (0.14, 0.55)):                    # "lub-dub"
            tt = t - (bt + off)
            m = tt >= 0
            e = np.exp(-np.where(m, tt, 0) / 0.11) * m
            heart += np.sin(TAU * np.cumsum(np.where(m, 80 * np.exp(-np.where(m, tt, 0) / 0.08) + 38, 0)) / SR) * e * amp
    heart *= beat_gain * 0.9

    # ---- sparkle chimes (A minor pentatonic, bell-like, inharmonic partials)
    pent = [880.0, 1046.5, 1318.5, 1568.0, 1760.0, 2093.0]
    chL = np.zeros(N)
    chR = np.zeros(N)
    for _ in range(26):
        ct = r.uniform(5.8, 14.0)
        f = r.choice(pent)
        tt = (t - ct) % LOOP                                           # wraps so tails loop
        e = np.exp(-tt / r.uniform(0.7, 1.6)) * (1 - np.exp(-tt / 0.004))
        v = (np.sin(TAU * f * tt) + 0.4 * np.sin(TAU * f * 2.76 * tt) + 0.15 * np.sin(TAU * f * 5.4 * tt)) * e
        v *= r.uniform(0.02, 0.06)
        p = r.uniform(0.1, 0.9)
        chL += v * (1 - p)
        chR += v * p

    # ---- mix with reverb
    dryL = drone * 0.55 + padL * 0.030 + riser + sweep + boom + heart
    dryR = drone * 0.55 + padR * 0.030 + riser * 0.9 + sweep + boom + heart
    wetL = _reverb(padL * 0.030 + chL * 1.6 + boom * 0.4, 3.4, 1)
    wetR = _reverb(padR * 0.030 + chR * 1.6 + boom * 0.4, 3.4, 2)
    L = dryL + chL + wetL * 0.9
    R = dryR + chR + wetR * 0.9

    # gentle master fade of the energy at the very ends is NOT needed (loop is seamless)
    out = np.stack([L, R], 1)
    out = np.tanh(out * 0.9)                                           # soft saturation / glue
    out /= np.max(np.abs(out)) / 0.85
    return np.ascontiguousarray((out * 32767).astype(np.int16))


def start_song():
    """Play MUSIC_FILE from MUSIC_START for one video cycle. Returns True if it worked."""
    import os
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), MUSIC_FILE)
    if not os.path.exists(path):
        return False
    try:
        if not pygame.mixer.get_init():
            pygame.mixer.init(frequency=SR, size=-16, channels=2, buffer=1024)
        pygame.mixer.music.load(path)
        pygame.mixer.music.play(loops=0, start=MUSIC_START, fade_ms=MUSIC_FADE_MS)
        return True
    except Exception as exc:                                           # noqa: BLE001
        print("Could not play", MUSIC_FILE, "->", exc)
        return False


def start_music(save_wav=True):
    """Generate + start the looping score. Fails quietly if there is no audio device."""
    try:
        pygame.mixer.init(frequency=SR, size=-16, channels=2, buffer=1024)
        data = make_music()
        if save_wav:
            import wave
            with wave.open("heart_eyes_music.wav", "wb") as wf:
                wf.setnchannels(2)
                wf.setsampwidth(2)
                wf.setframerate(SR)
                wf.writeframes(data.tobytes())
        snd = pygame.sndarray.make_sound(data)
        snd.play(loops=-1)
        return snd
    except Exception as exc:                                           # noqa: BLE001
        print("Audio disabled:", exc)
        return None


# Main
def main():
    pygame.init()
    W, H = COLS * CELL_W, ROWS * CELL_H
    screen = pygame.display.set_mode((W, H))
    pygame.display.set_caption("Eye -> Space")
    font = pygame.font.SysFont("couriernew,consolas,dejavusansmono,monospace", FONT_SIZE, bold=True)
    renderer = AsciiRenderer(font)
    clock = pygame.time.Clock()
    using_song = start_song()
    music = None
    if using_song:
        print(f"Playing {MUSIC_FILE} from {MUSIC_START:.0f}s")
    else:
        print(f"{MUSIC_FILE} not found -> composing built-in soundtrack...")
        music = start_music()
    muted = False
    cycle = 0
    t0 = pygame.time.get_ticks() / 1000
    shot = 0

    while True:
        for e in pygame.event.get():
            if e.type == pygame.QUIT or (e.type == pygame.KEYDOWN and e.key == pygame.K_ESCAPE):
                pygame.quit()
                sys.exit()
            if e.type == pygame.KEYDOWN:
                if e.key == pygame.K_SPACE:
                    t0 = pygame.time.get_ticks() / 1000
                    cycle = 0
                    if using_song:
                        start_song()
                    elif music:
                        music.stop()
                        music.play(loops=-1)
                if e.key == pygame.K_m:
                    muted = not muted
                    if using_song:
                        pygame.mixer.music.set_volume(0.0 if muted else 1.0)
                    elif music:
                        music.set_volume(0.0 if muted else 1.0)
                if e.key == pygame.K_s:
                    pygame.image.save(screen, f"heart_eyes_{shot}.png")
                    shot += 1

        t = pygame.time.get_ticks() / 1000 - t0
        # τραγούδι: στο τέλος κάθε κύκλου (LOOP) ξαναρχίζει από το MUSIC_START
        if using_song:
            c = int(t // LOOP)
            if c != cycle:
                cycle = c
                start_song()
            elif t % LOOP > LOOP - MUSIC_FADE_MS / 1000 and pygame.mixer.music.get_busy():
                pygame.mixer.music.fadeout(MUSIC_FADE_MS)
        screen.fill((4, 3, 5))
        renderer.draw(screen, compose(t))
        pygame.display.flip()
        clock.tick(FPS)


if __name__ == "__main__":
    main()

